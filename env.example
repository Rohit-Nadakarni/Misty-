BOT_TOKEN=your_telegram_bot_token_here
NVIDIA_API_KEY=your_nvidia_nim_key_here

# Weather: Google Maps Platform key with the Weather API enabled. A free Maps Demo Key works (100 calls a day).
GOOGLE_WEATHER_API_KEY=your_google_weather_key_here
# Oldest forecast (minutes) an automatic message may use. Misty only calls Google just before those messages.
# WEATHER_REFRESH_MIN=60
# WEATHER_DAILY_CAP=90
# WEATHER_MONTHLY_CAP=9000

# Web search (free tier at tavily.com, no card). Optional: without it Misty can still open links you paste.
TAVILY_API_KEY=your_tavily_key_here
# Boost results from one country for general searches, e.g. india. Empty = off.
# TAVILY_COUNTRY=india
# Soft cap on web lookups per month (Tavily's free tier is about 1,000 credits).
# SEARCH_MONTHLY_CAP=900
# BRAVE_API_KEY=

# Misty's tools (tasks, events, timers, web...). 0 = chat only.
# AGENT_TOOLS=1

# Optional. NVIDIA retires models now and then (HTTP 410). Check build.nvidia.com for current ones.
# NVIDIA_MODEL=openai/gpt-oss-120b
# NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/llama-3.3-nemotron-super-49b-v1

# Backstory mode: 1 = Misty tells the Ov.EL labs lore in chat (for fun), 0 = checked facts only.
# LORE_MODE=1
# Only used when LORE_MODE=0. Set to 1 only if Ov.EL labs really fine-tuned the model.
# OVEL_FINE_TUNED=0
